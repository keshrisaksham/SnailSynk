# .gitignore

# Install lock file
.install_lock
install.loc
Current

# Install log
*.log

# Environment variables
.env

# Python cache
__pycache__/
*.pyc

# Instance folder with user credentials
instance/

# Old files
admin.js

#old_backbone/
Backbone.py

#Old Directory
Old_files/
# Package manager bookkeeping
node_modules/

# Packaging output
build/
dist/

# Virtual environments
.venv/
venv/

# Safety net: private data must never be committed, even if copied outside instance/
.env.*
*.pem
*.key
*.crt
secret_key
user.json
user.json.*
conversations/
buffer_history.json
content_state.json
file_metadata.json
share_links.json
blocklist.json
actions.jsonl*
notes_ui.json
